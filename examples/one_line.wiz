let age = 20

let status = when age >= 18 { "Adult" } else { "Child" }
echo(status)

echo($"You are {when age >= 18 { "adult" } else { "child" }}")

let max = func(a, b) => when a > b { a } else { b }
echo(max(3, 7))

func is_even(n) => n % 2 == 0
echo(is_even(4))
echo(is_even(7))

func score(grade) => when grade >= 90 { "A" } else when grade >= 75 { "B" } else { "C" }
echo(score(95))
echo(score(80))
echo(score(50))

echo($"Result: {max(10, 4) + 1}")

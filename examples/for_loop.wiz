let numbers = [1, 5, 3, 6, 7, 19]

for i in numbers {
    echo(i, end=" ")
    
}
echo("")

for c in "Wizard" {
    echo(c, end=" - ")
}

echo("")
for i in 0..20 {
    echo(i, end=" ")
    
}
echo("")
for i in 0..20 step 2 {
    echo(i, end=" ")
    
}
echo("")
for i in 20..0 {
    echo(i, end=" ")
}
echo("")
for i in 20..0 step -2 {
    echo(i, end=" ")
}

